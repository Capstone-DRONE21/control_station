{
  "name": "control-station",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/project.mjs dev",
    "dev:backend": "node scripts/project.mjs backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
